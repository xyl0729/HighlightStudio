*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.jsonl
*.safetensors
*.ckpt
*.pt
*.npz
*.joblib
*.zip
*.log

# Explicitly keep bundled lightweight inference calibration & ranker weights
!engine/learned/
!engine/learned/*.joblib
!engine/learned/*.json
!engine/learned/*.npz
!engine/signals/
!engine/signals/**
!engine/signals/**/*.npz
!engine/signals/**/*.pt

# Frontend build & dependencies
node_modules/
dist/
*.tsbuildinfo
